# 应用
APP_NAME=enterprise-ai-agent
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
# 本机访问用 127.0.0.1；容器内/局域网访问改为 0.0.0.0
HOST=127.0.0.1
PORT=8000

# LLM：DeepSeek（OpenAI 兼容协议）
OPENAI_API_KEY=sk-your-key
OPENAI_API_BASE=https://api.deepseek.com
# 可选：deepseek-flash（V4.1-Flash，支持图像理解） / deepseek-v4-pro（V4-Pro，推理更强）
OPENAI_MODEL=deepseek-flash
# 思考模式：true 启用（更强推理，temperature 失效、延迟与费用更高）
OPENAI_THINKING=false

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=agent_knowledge

# 会话 / Trace 持久化
CONVERSATION_PERSISTENCE_ENABLED=true
TRACE_PERSISTENCE_ENABLED=true

# RAG 缓存与混合检索
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=3600
RAG_RETRIEVAL_MODE=hybrid

# 通用 Agent Orchestrator
AGENT_ORCHESTRATOR_ENABLED=true
AGENT_MAX_STEPS=8

# 意图识别：强规则优先，语义近邻兜底
INTENT_SEMANTIC_ENABLED=true
INTENT_SEMANTIC_MIN_SIMILARITY=0.65

# LLM 瞬时错误重试（不重试 4xx；熔断器仍负责跨请求保护）
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_DELAY=0.5
LLM_RETRY_MAX_DELAY=5.0

# 日志
LOG_LEVEL=INFO

# 上传
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# RAG（知识库检索增强）
RAG_ENABLED=true
RAG_TOP_K=4
# 向量距离阈值（L2，越小越相似）；超过则视为未命中，回退普通对话
RAG_MAX_DISTANCE=1.1
RAG_COLLECTION_NAME=knowledge_chunks
# 中文嵌入模型；已缓存于本地时配合 EMBEDDING_LOCAL_ONLY=true 可离线运行
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_LOCAL_ONLY=true
# 也可用本地路径，例如 EMBEDDING_MODEL=C:/models/bge-large-zh-v1.5（注意维度变化，需同步更换集合名）
# RAG_COLLECTION_NAME=knowledge_chunks_bge_large
# 重排模型：留空表示不启用；可填仓库名或本地路径，例如 C:/models/bge-reranker-v2-m3
RERANKER_MODEL=
RAG_RERANK_CANDIDATES=12

# 知识库源目录：放入文件即自动入库（启动扫描 / 脚本 / HTTP 三种触发方式）
KNOWLEDGE_DIR=knowledge
KNOWLEDGE_AUTOSCAN=true

# 退款 Agent 工具（默认关闭；不单独开服务/路由）
REFUND_ENABLED=false
REFUND_DATA_DIR=data/refund
# 仅演示/回归时 seed 264 条数据；生产保持 false
REFUND_SEED_DATASET=false
