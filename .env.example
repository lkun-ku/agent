# 应用
APP_NAME=enterprise-ai-agent
APP_ENV=development
DEBUG=true
# 是否启用 Agent 编排（false 时 /chat 走原直通逻辑）
AGENT_ENABLED=false
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# OpenAI / 兼容 API
OPENAI_API_KEY=sk-your-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=agent_knowledge

# 日志
LOG_LEVEL=INFO

# 可观测（可选）：OTLP/HTTP JSON 导出地址，留空则不导出
OTLP_ENDPOINT=
TRACE_JSONL_PATH=logs/trace.jsonl

# OCR（可选）：需安装 .[ocr] 与 tesseract/poppler
OCR_ENABLED=false
